{
  "name": "@aeth/kernel-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "aeth": {
    "target": "node"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "node ../../tools/scripts/remove-paths.mjs dist .tsbuildinfo",
    "test": "vitest run --maxWorkers=1",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@aeth/child-process-env": "workspace:*",
    "@aeth/geometry-contracts": "workspace:*",
    "@aeth/ipc": "workspace:*"
  }
}
