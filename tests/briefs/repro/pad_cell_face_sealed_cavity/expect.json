{
 "item": 1,
 "claim": "(face N CELL top|bottom) on a boolean body resolves to the face its name nN.cK.top|bottom implies, or is refused naming the faces to use; a holes or pocket cut that leaves a sealed cavity is refused with the face it opens through, and following that fix commits",
 "limit_s": 60,
 "steps": [
  {
   "args": [
    "faces",
    "4",
    "-f"
   ],
   "must": [
    "^n3\\.c0\\.top plane loops=2 frame o=\\(0,0,26\\)",
    "^n4\\.c0\\.bottom plane loops=1 frame o=\\(0,0,20\\)"
   ],
   "must_not": [
    "n4\\.cav"
   ]
  },
  {
   "args": [
    "check",
    "4"
   ],
   "must": [
    "^ok:"
   ]
  },
  {
   "args": [
    "apply",
    "(node 5 (holes 3 (face 2 n2.c0.top) 1 (hole 10 10 2)) (intent remove any any 1 any))"
   ],
   "must": [
    "^node 5: error .*feature-sealed-cavity",
    "^rejected"
   ],
   "must_not": [
    "^committed"
   ],
   "capture": {
    "F": "fix: start the cut on the face it opens through: \\(face 3 (\\S+?)\\)"
   }
  },
  {
   "args": [
    "apply",
    "(node 5 (holes 3 (face 3 {F}) 1 (hole 10 10 2)) (intent remove any any 1 any))"
   ],
   "must": [
    "^committed"
   ]
  },
  {
   "args": [
    "faces",
    "5",
    "-f"
   ],
   "must": [
    "^n5\\.c0\\.bottom plane loops=1 frame o=\\(0,0,25\\)"
   ],
   "must_not": [
    "n5\\.cav"
   ]
  },
  {
   "args": [
    "apply",
    "(node 6 (holes 3 (face 3 0 bottom) 2 (hole 10 10 1)) (intent remove any any 1 any))"
   ],
   "must": [
    "^node 6: error .*face-not-found: n3\\.c0\\.bottom",
    "^rejected"
   ],
   "must_not": [
    "^committed"
   ],
   "capture": {
    "FB": "fix: .*?\\(face 3 (n\\S+?\\.bottom)\\)"
   }
  },
  {
   "args": [
    "apply",
    "(node 6 (holes 3 (face 3 {FB}) 2 (hole 10 -10 1)) (intent remove any any 1 any))"
   ],
   "must": [
    "^committed"
   ]
  },
  {
   "args": [
    "faces",
    "6",
    "-f"
   ],
   "must": [
    "^n6\\.c0\\.bottom plane loops=1 frame o=\\(0,0,2\\)"
   ],
   "must_not": [
    "n6\\.cav"
   ]
  }
 ]
}
