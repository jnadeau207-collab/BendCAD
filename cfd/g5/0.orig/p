FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
dimensions [1 -1 -2 0 0 0 0];
internalField uniform 101325;
boundaryField
{
    "(inlet|ambient)" { type totalPressure; p0 uniform 101325; value uniform 101325; }
    outlet { type fixedValue; value uniform 101325; }
    "(impeller|turbine|shaft|nut_front|nut_rear|spacer|intake|front_cover|diffuser|casing|tunnel|liner|fuel_ring|lube_tube|ngv|exhaust)" { type zeroGradient; }
}
